{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bag of Holding",
  "version": "0.0.0",
  "identifier": "com.bagofholding.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter @boh/web dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --filter @boh/web build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "security": {
      "csp": null
    },
    "windows": []
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhFQTEwNzczNzlBODEzOUYKUldTZkU2aDVjd2VoamoybVpQRGV6TzhLKzhkVDluRVRaMDlUQW5OcGNvdGVjQ3docGpic2I0VEwK",
      "endpoints": [
        "https://github.com/Afrost34/bag-of-holding-2/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
