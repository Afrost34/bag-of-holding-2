{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bag of Holding",
  "version": "0.0.0",
  "identifier": "com.bagofholding.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter @boh/web dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --filter @boh/web build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Bag of Holding",
        "width": 1440,
        "height": 900,
        "minWidth": 400,
        "minHeight": 500,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
